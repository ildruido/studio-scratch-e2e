{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npx playwright *)",
      "Bash(node .claude/studio/studio-sync.mjs *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/cloud-setup.mjs",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "node .claude/studio/studio-sync.mjs check --warn",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check.mjs commit",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "mcp__.*github.*__(merge_pull_request|enable_pr_auto_merge|pull_request_review_write)",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check.mjs merge",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__.*github.*__(push_files|create_or_update_file|delete_file)",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check.mjs write",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check.mjs lint",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check.mjs test",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
